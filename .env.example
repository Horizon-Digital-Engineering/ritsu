# Static / boot-time configuration. Dynamic agent definitions, workspaces,
# and tokens live in the SQLite DB (managed via the admin UI).

# NOTE: dotenv does not strip inline `# comments` from values — keep
# comments on their own line. `KEY=value # comment` is read as the literal
# string "value # comment" and breaks anything that parses it.

# ---- MCP surface (where MCP clients connect) -------------------------------
PORT=7333
# 0.0.0.0 for network-reachable; 127.0.0.1 for local-only
MCP_HOST=127.0.0.1

# Auth mode for /mcp:
#   auto  (default) — open until a token exists, then auto-locked
#   on              — always require a bearer token
#   off             — never require (trusted private network only)
MCP_REQUIRE_AUTH=auto

# ---- Admin surface (CRUD + management UI) ----------------------------------
# Every /admin route requires a bearer admin token (mode 0600 file +
# bootstrapped on first run). The 127.0.0.1 default is defence-in-depth
# on top of that — flip to a routable address only after you've put the
# admin port behind a reverse proxy or tailnet ACL.
ADMIN_PORT=7334
ADMIN_HOST=127.0.0.1

# ---- Storage ---------------------------------------------------------------
# One SQLite file holds everything: agent_definitions, memories, conversations,
# messages, mcp_tokens, mcp_token_usage, agent_workspaces.
DB_PATH=./data/ritsu.db

# ---- Bootstrap admin token -------------------------------------------------
# On first start, the server mints an admin token and writes the plaintext
# here (mode 0600). Reads:
#   - server: writes to this path during bootstrap (fail-closed: if the
#     write fails the token is revoked and the process exits)
#   - CLI: `ritsu admin-token show` and every other `ritsu` subcommand
#     read from here by default
#
# Dev default (writable by the dev's own user): ./data/.admin-token
# Production (installer-written /etc/ritsu/env): /opt/ritsu/data/.admin-token
RITSU_ADMIN_TOKEN_FILE=./data/.admin-token

# ---- Bash sandboxing (opt-in) ---------------------------------------------
# Set to 1 to wrap the ritsu-agent Bash tool in bwrap (bubblewrap).
# - ro-bind /, rw-bind only the workspace, private /tmp
# - --die-with-parent, --new-session, --cap-drop ALL
# - --unshare-pid/uts/ipc (network kept for legit curl; SSRF guard on
#   WebFetch is the trade-off)
# Requires `apt install bubblewrap` or the distro equivalent. If set but
# bwrap isn't installed, Bash calls fail loud with a remediation hint.
# RITSU_BASH_SANDBOX=0

# ---- LiteLLM sidecar + ingest/vision model ---------------------------------
# Configured in the admin Secrets UI (namespaces 'litellm' and 'ingest'),
# encrypted at rest — NOT here. litellm: url (default http://localhost:4000) +
# api_key (only if the proxy requires one). ingest: endpoint + model + api_key
# for the cheap local vision extractor (falls back to the Max-plan vision read
# when unset).

# ---- Logging ---------------------------------------------------------------
# Initial level; can be changed at runtime via the admin UI Logs tab.
LOG_LEVEL=info

# ---- Secret storage --------------------------------------------------------
# Secrets (subscription token, provider keys, connector credentials) are
# AES-256-GCM encrypted at rest and CANNOT be stored without a master key.
# Resolution order: this variable, then /etc/ritsu/master-key, then a
# colocated fallback that is refused by default because it would sit beside
# the database it protects. The installer creates the file for you.
#
# BACK THE KEY UP wherever it lives — it is deliberately excluded from
# database backups, so restoring a snapshot without it leaves every stored
# credential unreadable. Create one by hand with: ritsu master-key init
# RITSU_MASTER_KEY=

# ---- Model credentials -----------------------------------------------------
# The direct runtime authenticates with a long-lived subscription token
# (`claude setup-token`, account-scoped, about a year). Save it in the admin
# UI under API Keys — the supported path — or set it here.
# CLAUDE_CODE_OAUTH_TOKEN=
#
# ANTHROPIC_API_KEY is for the metered API, which is the `api` runtime's job
# with a key minted on the API Keys page. It takes precedence over a
# subscription token, so when one is stored the direct runtime drops this
# variable from the environment it hands the CLI — otherwise those turns
# would silently bill per token.
# ANTHROPIC_API_KEY=

# ---- Memory backend --------------------------------------------------------
# The store behind each turn's context retrieval + turn recording is configured
# at runtime in the admin Secrets UI (namespace 'flashback'), encrypted at rest
# — NOT here. With no flashback credentials set it stays sqlite-only (on-box, no
# network), the default unchanged behavior. To opt in, set in that namespace:
#   url, token          the flashback server + its bearer token
#   mode                sqlite | flashback | dual  (default dual once creds set;
#                       dual keeps the on-box store authoritative and writes the
#                       remote fire-and-forget, so a remote outage never blocks a
#                       turn)
#   timeout_ms          per-request timeout (default 5000)
#   proposal_poll_ms    proposal sweep interval (default 60000)
