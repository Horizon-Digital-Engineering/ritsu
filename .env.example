# Static / boot-time configuration. Dynamic agent definitions, workspaces,
# and tokens live in the SQLite DB (managed via the admin UI).

# NOTE: dotenv does not strip inline `# comments` from values — keep
# comments on their own line. `KEY=value # comment` is read as the literal
# string "value # comment" and breaks anything that parses it.

# ---- MCP surface (where MCP clients connect) -------------------------------
PORT=7333
# 0.0.0.0 for network-reachable; 127.0.0.1 for local-only
MCP_HOST=127.0.0.1

# Auth mode for /mcp:
#   auto  (default) — open until a token exists, then auto-locked
#   on              — always require a bearer token
#   off             — never require (trusted private network only)
MCP_REQUIRE_AUTH=auto

# ---- Admin surface (CRUD + management UI, NO auth in V1) -------------------
# Keep on 127.0.0.1 unless you've put auth in front of it. SSH-forward for remote.
ADMIN_PORT=7334
ADMIN_HOST=127.0.0.1

# ---- Storage ---------------------------------------------------------------
# One SQLite file holds everything: agent_definitions, memories, conversations,
# messages, mcp_tokens, mcp_token_usage, agent_workspaces.
DB_PATH=./data/ritsu.db

# ---- LiteLLM sidecar (only if any agent uses dispatcher: 'litellm') -------
LITELLM_URL=http://localhost:4000
# only if your LiteLLM proxy requires one:
# LITELLM_API_KEY=

# ---- Logging ---------------------------------------------------------------
# Initial level; can be changed at runtime via the admin UI Logs tab.
LOG_LEVEL=info

# ---- Claude (claude-direct dispatcher) ------------------------------------
# Default path: leave ANTHROPIC_API_KEY UNSET and ride the Max-plan CLI
# session at ~/.claude/. The Claude Agent SDK ships its own bundled cli.js,
# so no `claude` binary needs to be on PATH.
# If ANTHROPIC_API_KEY is set, the SDK may use it preferentially and you
# will pay API rates instead of $0 marginal.
# ANTHROPIC_API_KEY=
