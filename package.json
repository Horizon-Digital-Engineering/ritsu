{
  "name": "ritsu",
  "version": "0.10.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/admin && cp src/admin/ui.html dist/admin/ui.html && cp src/admin/app.js dist/admin/app.js && cp src/admin/app.css dist/admin/app.css && for d in src/plugins/*/ui; do [ -d \"$d\" ] || continue; dest=\"dist/plugins/$(basename \"$(dirname \"$d\")\")/ui\"; mkdir -p \"$dest\" && cp \"$d\"/* \"$dest\"/; done && chmod +x dist/cli.js",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "tsx --test src/__tests__/*.test.ts",
    "test:coverage": "c8 --reporter=lcov --reporter=text --src=src --exclude='src/__tests__/**' --exclude='src/admin/app.js' tsx --test src/__tests__/*.test.ts",
    "scan:secrets": "./scripts/scan-secrets.sh"
  },
  "bin": {
    "ritsu": "./dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.217",
    "@google/genai": "^2.13.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^5.2.1",
    "imapflow": "^1.4.8",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "openai": "^6.49.0",
    "re2-wasm": "^1.0.2",
    "twitter-api-v2": "^1.29.0",
    "undici": "^8.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  }
}
